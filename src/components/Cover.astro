---
import type { ImageMetadata } from 'astro';
import Photo from './cover/Photo.astro';
import Stamp from './cover/Stamp.astro';
import Brush from './Brush.astro';
import type { Layout, Palette } from '../lib/cover';

interface Props {
  layout: Layout;
  palette: Palette;
  kicker: string;
  title: string;
  summary?: string;
  date: Date;
  label?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'full' | 'card';
}

const { layout, palette, kicker, title, summary, date, label, image, imageAlt = '', size = 'full' } = Astro.props;
const stamp = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const foot = `drei.gg/log · ${stamp}${label ? ` · ${label}` : ''}`;
const blurb = summary ?? title;
const letters = [...kicker.replace(/\s+/g, '')].slice(0, 8);
const photo = { image, alt: imageAlt, fallback: kicker };
const dd = date.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' });
const mm = date.toLocaleDateString('en-GB', { month: '2-digit', timeZone: 'UTC' });
// Font size (in cqw) that fits a word of condensed caps into a given width.
const fit = (text: string, width: number, max: number) => Math.min(max, width / (Math.max(text.length, 1) * 0.5));
const script = kicker.toLowerCase().replace(/\s+/g, '');
---

<figure class={`cv cv-${layout} pal-${palette} cv-${size}`} aria-label={title}>
  {
    layout === 'giveaway' && (
      <>
        <span class="main-blk" />
        <Photo {...photo} class="p" />
        <p class="vk">{kicker}</p>
        <Stamp class="st" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dotgrid" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'streetwear' && (
      <>
        <p class="t">{title}</p>
        <Stamp class="st" />
        <span class="tint" />
        <Photo {...photo} class="p" />
        <span class="hatch" />
        <span class="dotgrid" />
        <span class="tick" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'everyday' && (
      <>
        <span class="main-blk" />
        <span class="tri" />
        <Photo {...photo} class="p" />
        <p class="t">{title}</p>
        <p class="foot">{blurb === title ? foot : blurb}</p>
        <span class="dotgrid" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'offset' && (
      <>
        <span class="hatch" />
        <span class="dotgrid" />
        <span class="main-blk" />
        <Photo {...photo} class="p" />
        <span class="tick" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }


  {
    layout === 'bracket' && (
      <>
        <div class="sq">
          <span class="corner tl" />
          <span class="corner br" />
          <span class="qm" aria-hidden="true">
            “
          </span>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <Photo {...photo} class="p" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'tiles' && (
      <>
        <Photo {...photo} class="p p1" position="left top" />
        <div class="kt">
          <p class="k">{kicker}</p>
          <span class="dots" aria-hidden="true">
            •••
          </span>
        </div>
        <div class="it">
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <Photo {...photo} class="p p2" position="right bottom" />
      </>
    )
  }

  {
    layout === 'caption' && (
      <>
        <Photo {...photo} class="p" />
        <span class="hatch" />
        <div class="panel">
          <p class="lbl">
            <span>{kicker}</span>
          </p>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'quarter' && (
      <>
        <span class="xx" aria-hidden="true" />
        <span class="moon" />
        <Photo {...photo} class="p" bw />
        <p class="side">{blurb}</p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dot" />
      </>
    )
  }

  {
    layout === 'spread' && (
      <>
        <Brush class="b1" />
        <Brush class="b2" variant={2} />
        <Photo {...photo} class="p" />
        <div class="letters" aria-hidden="true" style={`--cols: ${Math.ceil(letters.length / 2)}`}>
          {letters.map((c) => (
            <span>{c}</span>
          ))}
        </div>
        <p class="lbl">
          <span>{title}</span>
        </p>
      </>
    )
  }

  {
    layout === 'lshape' && (
      <>
        <span class="l1" />
        <span class="l2" />
        <Photo {...photo} class="p" />
        <p class="lbl">
          <span>{title}</span>
        </p>
        <p class="k">{kicker}</p>
        <Brush class="b1" />
        <span class="tick" />
      </>
    )
  }

  {/* ---- Type-only layouts: for posts without an image ---- */}

  {
    layout === 'repeat' && (
      <>
        <span class="frame" />
        <div class="rows" aria-hidden="true">
          <span>{kicker} {kicker} {kicker}</span>
          <span class="o">{kicker} {kicker} {kicker}</span>
          <span>{kicker} {kicker} {kicker}</span>
          <span class="o">{kicker} {kicker} {kicker}</span>
        </div>
        <span class="dot" />
        <p class="lbl">
          <span>{title}</span>
        </p>
      </>
    )
  }

  {
    layout === 'arc' && (
      <>
        <p class="num">
          {dd}
          <span>{mm}</span>
        </p>
        <span class="ring" />
        <div class="col">
          <p class="t">{title}</p>
          <p class="k">{kicker}</p>
          <p class="foot">{foot}</p>
        </div>
      </>
    )
  }

  {
    layout === 'stripes' && (
      <>
        <p class="k" style={`font-size: ${fit(kicker, 84, 24)}cqw`}>
          {kicker}
        </p>
        <span class="bars" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'bignum' && (
      <>
        <p class="side" aria-hidden="true">
          {kicker} {kicker} {kicker} {kicker} {kicker}
        </p>
        <p class="side r" aria-hidden="true">
          {kicker} {kicker} {kicker} {kicker} {kicker}
        </p>
        <p class="t">{title}</p>
        <p class="k" style={`font-size: ${fit(kicker, 70, 30)}cqw`}>
          {kicker}
        </p>
        <span class="dot" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'collection' && (
      <>
        <span class="ring" />
        <span class="blk" />
        <div class="col">
          <p class="t">{title}</p>
          {summary && <p class="s">{summary}</p>}
          <p class="foot">{foot}</p>
        </div>
        <span class="xx" aria-hidden="true" />
      </>
    )
  }

  {
    layout === 'clearance' && (
      <>
        <Brush class="b1" variant={2} />
        <div class="grid" aria-hidden="true">
          {[...kicker.replace(/\s+/g, '')].slice(0, 12).map((c) => (
            <span>{c}</span>
          ))}
        </div>
        <p class="lbl">
          <span>{title}</span>
        </p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'wild' && (
      <>
        <Brush class="b1" />
        <Brush class="b2" variant={2} />
        <Brush class="b3" />
        <Brush class="b4" variant={2} />
        <p class="sc">#{script}</p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'promo' && (
      <>
        <div class="a">
          <p class="k" style={`font-size: ${fit(kicker, 38, 15)}cqw`}>
            {kicker}
          </p>
        </div>
        <p class="b">new post</p>
        <p class="c">drei.gg/log</p>
        <p class="t">{title}</p>
        <Brush class="b1" />
        <p class="foot">{foot}</p>
        <span class="dotgrid" />
        <span class="dot" />
      </>
    )
  }

  {
    layout === 'quote' && (
      <>
        <div class="sq">
          <span class="corner tl" />
          <span class="corner br" />
          <span class="qm" aria-hidden="true">
            “
          </span>
          <p class="q">{blurb}</p>
          <p class="foot">— drei · {stamp}</p>
        </div>
      </>
    )
  }

  {
    layout === 'term' && (
      <>
        <div class="win">
          <p class="bar">
            <i />
            <i />
            <i />
            <span>drei@aeris: ~/log</span>
          </p>
          <p class="cmd">$ drei log --tag {kicker.toLowerCase()}</p>
          <p class="t">
            <b>&gt;</b> {title}
            <span class="cur" />
          </p>
          <p class="foot">{foot}</p>
        </div>
        <span class="dotgrid" />
      </>
    )
  }

  {/* ---- More image layouts ---- */}

  {
    layout === 'split' && (
      <>
        <div class="stack" aria-hidden="true" style={`font-size: ${fit(kicker, 40, 12)}cqw`}>
          <span>{kicker}</span>
          <span class="o">{kicker}</span>
          <span>{kicker}</span>
        </div>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dark" />
        <Photo {...photo} class="p" bw />
        <span class="ring" />
      </>
    )
  }

  {
    layout === 'circle' && (
      <>
        <span class="disc" />
        <Photo {...photo} class="p" />
        <span class="xx" aria-hidden="true" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dot" />
        <span class="dotgrid" />
      </>
    )
  }

  {
    layout === 'twin' && (
      <>
        <span class="band1" />
        <span class="band2" />
        <Photo {...photo} class="p p1" position="center 30%" />
        <Photo {...photo} class="p p2" position="center 80%" />
        <Brush class="b1" />
        <p class="lbl">
          <span>{kicker}</span>
        </p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'ushape' && (
      <>
        <span class="u" />
        <Photo {...photo} class="p" />
        <Brush class="x1" />
        <Brush class="x2" variant={2} />
        <p class="lbl">
          <span>{kicker}</span>
        </p>
        <p class="t">{title}</p>
        <Brush class="under" variant={2} />
        <p class="sc">#{script}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'bleed' && (
      <>
        <Photo {...photo} class="p" />
        <div class="bar">
          <p class="lbl">
            <span>{kicker}</span>
          </p>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'arch' && (
      <>
        <span class="sun" />
        <div class="col">
          <p class="t">{title}</p>
          {summary && <p class="s">{summary}</p>}
        </div>
        <Photo {...photo} class="p" />
        <span class="dotgrid" />
        <span class="hatch" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'polaroid' && (
      <>
        <span class="dotgrid" />
        <div class="card">
          <Photo {...photo} class="p" />
          <p class="sc">{script}</p>
        </div>
        <span class="tape" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dot" />
      </>
    )
  }

  {
    layout === 'filmstrip' && (
      <>
        <span class="strip" />
        <Photo {...photo} class="p f1" position="left center" />
        <Photo {...photo} class="p f2" position="center center" bw />
        <Photo {...photo} class="p f3" position="right center" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'browser' && (
      <>
        <span class="main-blk" />
        <div class="win">
          <p class="bar">
            <i />
            <i />
            <i />
            <span>drei.gg/log</span>
          </p>
          <Photo {...photo} class="p" position="left top" />
        </div>
        <p class="lbl">
          <span>{kicker}</span>
        </p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dotgrid" />
        <span class="tick" />
      </>
    )
  }
  {/* ---- Second batch: Memphis shapes, black-and-yellow blocks, story posters ---- */}

  {
    layout === 'bubbles' && (
      <>
        <span class="c1" />
        <span class="c2" />
        <span class="q1" />
        <span class="q2" />
        <p class="t">{title}</p>
        <Photo {...photo} class="p" />
        <span class="dotgrid g1" />
        <span class="dotgrid g2" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'porthole' && (
      <>
        <span class="c1" />
        <span class="c2" />
        <span class="q2" />
        <Photo {...photo} class="p" />
        <div class="col">
          <p class="t">{title}</p>
          {summary && <p class="s">{summary}</p>}
          <p class="more">read more</p>
        </div>
        <span class="dotgrid" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'triptych' && (
      <>
        <span class="c2" />
        <span class="c1" />
        <Photo {...photo} class="p f1" position="left center" />
        <Photo {...photo} class="p f2" position="center center" />
        <Photo {...photo} class="p f3" position="right center" />
        <span class="dline" />
        <p class="t">{title}</p>
        <span class="dotgrid" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'slab' && (
      <>
        <span class="frame" />
        <span class="cap1" />
        <span class="cap2" />
        <div class="colm">
          <p class="t">{title}</p>
          {summary && <p class="s">{summary}</p>}
          <p class="more">read →</p>
        </div>
        <Photo {...photo} class="p" />
      </>
    )
  }

  {
    layout === 'quadrant' && (
      <>
        <span class="blk" />
        <span class="band" />
        <Photo {...photo} class="p" />
        <p class="t">{title}</p>
        <p class="s">{blurb}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'banner' && (
      <>
        <span class="top" />
        <p class="t">{title}</p>
        {summary && <p class="s">{summary}</p>}
        <span class="frame" />
        <Photo {...photo} class="p" />
        <p class="more">read it</p>
      </>
    )
  }

  {
    layout === 'tilt' && (
      <>
        <div class="wall" aria-hidden="true">
          <span>{kicker} {kicker} {kicker}</span>
          <span>{kicker} {kicker} {kicker}</span>
          <span>{kicker} {kicker} {kicker}</span>
          <span>{kicker} {kicker} {kicker}</span>
        </div>
        <Photo {...photo} class="p" />
        <p class="k2">{kicker}</p>
        <p class="lbl">
          <span>{title}</span>
        </p>
      </>
    )
  }

  {
    layout === 'glow' && (
      <>
        <Photo {...photo} class="p" bw />
        <span class="shade" />
        <span class="band b1" />
        <span class="band b2" />
        <p class="k2">{kicker}</p>
        <p class="t">{title}</p>
        <p class="more">{stamp}</p>
      </>
    )
  }

  {
    layout === 'duo' && (
      <>
        <p class="pre">drei.gg presents</p>
        <p class="t">{title}</p>
        <p class="k">{kicker}</p>
        <p class="foot">{foot}</p>
        <Photo {...photo} class="p p1" position="center 30%" />
        <Photo {...photo} class="p p2" position="center 75%" />
        <p class="tag tg1">drei</p>
        <p class="tag tg2">{stamp}</p>
        <p class="burst">
          <span>
            ep.
            <b>{dd}</b>
          </span>
        </p>
      </>
    )
  }

  {
    layout === 'tips' && (
      <>
        <p class="num">
          <span>{kicker}</span>
        </p>
        <p class="t">{title}</p>
        <svg class="zz" viewBox="0 0 60 10" aria-hidden="true">
          <path d="M1 8 L6 2 L11 8 L16 2 L21 8 L26 2 L31 8 L36 2 L41 8 L46 2 L51 8 L56 2" fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <p class="s">{blurb}</p>
        <span class="dline" />
        <span class="arrow">→</span>
        <span class="hatchball" />
        <span class="ring r1" />
        <span class="ring r2" />
        <span class="ring r3" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'xband' && (
      <>
        <span class="lights" />
        <span class="band b1" />
        <span class="band b2" />
        <p class="k2">{kicker}</p>
        <p class="t">{title}</p>
        <p class="more">read it</p>
      </>
    )
  }

  {
    layout === 'marquee' && (
      <>
        <span class="bulbs" />
        <p class="t">{title}</p>
        <p class="k2">{kicker}</p>
        <span class="disc" />
        <Stamp class="st" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'orb' && (
      <>
        <span class="stripes" />
        <span class="ball" />
        <span class="moon" />
        <div class="in">
          <p class="t">{title}</p>
          <p class="k">{kicker}</p>
        </div>
        <span class="dotgrid" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'glyph' && (
      <>
        <span class="half" />
        <p class="g" aria-hidden="true">
          {[...kicker][0]}
        </p>
        <span class="hatch" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'pill' && (
      <>
        <span class="bar" />
        <span class="pillb" />
        <p class="t">{title}</p>
        <span class="dotgrid" />
        <span class="stripes" />
        <span class="hatch" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'poster' && (
      <>
        <span class="y" />
        <span class="panel" />
        <span class="frame" />
        <p class="chev" aria-hidden="true">
          ››››››
        </p>
        <p class="k2">{kicker}</p>
        <p class="t">{title}</p>
        <span class="field" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'tower' && (
      <>
        <span class="slabb" />
        <span class="strip" />
        <span class="line" />
        <p class="plus" aria-hidden="true">
          + + + +
        </p>
        <span class="hatch" />
        <p class="k">{kicker}</p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }
</figure>
