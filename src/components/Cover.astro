---
import type { ImageMetadata } from 'astro';
import Photo from './cover/Photo.astro';
import Stamp from './cover/Stamp.astro';
import Brush from './Brush.astro';
import type { Layout, Palette } from '../lib/cover';

interface Props {
  layout: Layout;
  palette: Palette;
  kicker: string;
  title: string;
  summary?: string;
  date: Date;
  label?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'full' | 'card';
}

const { layout, palette, kicker, title, summary, date, label, image, imageAlt = '', size = 'full' } = Astro.props;
const stamp = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const foot = `drei.gg/log · ${stamp}${label ? ` · ${label}` : ''}`;
const blurb = summary ?? title;
const letters = [...kicker.replace(/\s+/g, '')].slice(0, 8);
const photo = { image, alt: imageAlt, fallback: kicker };
---

<figure class={`cv cv-${layout} pal-${palette} cv-${size}`} aria-label={title}>
  {
    layout === 'giveaway' && (
      <>
        <span class="main-blk" />
        <Photo {...photo} class="p" />
        <p class="vk">{kicker}</p>
        <Stamp class="st" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dotgrid" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'streetwear' && (
      <>
        <p class="t">{title}</p>
        <Stamp class="st" />
        <span class="tint" />
        <Photo {...photo} class="p" />
        <span class="hatch" />
        <span class="dotgrid" />
        <span class="tick" />
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'everyday' && (
      <>
        <span class="main-blk" />
        <span class="tri" />
        <Photo {...photo} class="p" />
        <p class="t">{title}</p>
        <p class="foot">{blurb === title ? foot : blurb}</p>
        <span class="dotgrid" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'offset' && (
      <>
        <span class="hatch" />
        <span class="dotgrid" />
        <span class="main-blk" />
        <Photo {...photo} class="p" />
        <span class="tick" />
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
      </>
    )
  }

  {
    layout === 'overlay' && (
      <>
        <Photo {...photo} class="p" />
        <div class="panel">
          <p class="k">{kicker}</p>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <Stamp class="st" />
        <span class="dotgrid" />
      </>
    )
  }

  {
    layout === 'bracket' && (
      <>
        <div class="sq">
          <span class="corner tl" />
          <span class="corner br" />
          <span class="qm" aria-hidden="true">
            “
          </span>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <Photo {...photo} class="p" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'tiles' && (
      <>
        <Photo {...photo} class="p p1" position="left top" />
        <div class="kt">
          <p class="k">{kicker}</p>
          <span class="dots" aria-hidden="true">
            •••
          </span>
        </div>
        <div class="it">
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <Photo {...photo} class="p p2" position="right bottom" />
      </>
    )
  }

  {
    layout === 'caption' && (
      <>
        <Photo {...photo} class="p" />
        <span class="hatch" />
        <div class="panel">
          <p class="lbl">
            <span>{kicker}</span>
          </p>
          <p class="t">{title}</p>
          <p class="foot">{foot}</p>
        </div>
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'quarter' && (
      <>
        <span class="xx" aria-hidden="true" />
        <span class="moon" />
        <Photo {...photo} class="p" bw />
        <p class="side">{blurb}</p>
        <p class="t">{title}</p>
        <p class="foot">{foot}</p>
        <span class="dot" />
      </>
    )
  }

  {
    layout === 'spread' && (
      <>
        <Brush class="b1" />
        <Brush class="b2" variant={2} />
        <Photo {...photo} class="p" />
        <div class="letters" aria-hidden="true" style={`--cols: ${Math.ceil(letters.length / 2)}`}>
          {letters.map((c) => (
            <span>{c}</span>
          ))}
        </div>
        <p class="lbl">
          <span>{title}</span>
        </p>
      </>
    )
  }

  {
    layout === 'lshape' && (
      <>
        <span class="l1" />
        <span class="l2" />
        <Photo {...photo} class="p" />
        <p class="lbl">
          <span>{title}</span>
        </p>
        <p class="k">{kicker}</p>
        <Brush class="b1" />
        <span class="tick" />
      </>
    )
  }

  {
    layout === 'mono' && (
      <>
        <Photo {...photo} class="p" bw />
        <div class="stack" aria-hidden="true">
          <span>{kicker}</span>
          <span class="o">{kicker}</span>
          <span>{kicker}</span>
        </div>
        <p class="t">{title}</p>
        <span class="dot" />
      </>
    )
  }
</figure>
