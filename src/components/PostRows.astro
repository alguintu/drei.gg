---
// A compact list of posts, grouped by year: the archive and the tag pages.
import { formatDate, postUrl, LABELS, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

{
  years.map((year) => (
    <section class="year">
      <h2>{year}</h2>
      <ol class="rows">
        {posts
          .filter((p) => p.data.date.getUTCFullYear() === year)
          .map((p) => (
            <li>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
              <a class="tag" href={`/tag/${p.data.tag}/`}>{LABELS[p.data.tag]}</a>
              <span class="what">
                <a href={postUrl(p)}>{p.data.title}</a>
                {p.data.summary && <span class="sum">{p.data.summary}</span>}
              </span>
            </li>
          ))}
      </ol>
    </section>
  ))
}
