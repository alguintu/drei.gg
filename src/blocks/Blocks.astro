---
// Draws a list of blocks: each block's `type` picks its component.
import type { BlockData, BlockType } from './schema';
import type { Path } from './desk';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Killfeed from './Killfeed.astro';
import PostLog from './PostLog.astro';
import Inventory from './Inventory.astro';
import Rules from './Rules.astro';
import Scoreboard from './Scoreboard.astro';
import CoverBlock from './CoverBlock.astro';
import PostBlock from './PostBlock.astro';
import Heading from './Heading.astro';
import Prose from './Prose.astro';
import PostList from './PostList.astro';
import Embed from './Embed.astro';
import Search from './Search.astro';
import Project from './Project.astro';
import Links from './Links.astro';
import Roadmap from './Roadmap.astro';
import Faq from './Faq.astro';
import Masthead from './Masthead.astro';
import Features from './Features.astro';
import Pricing from './Pricing.astro';
import Testimonials from './Testimonials.astro';
import People from './People.astro';
import Timeline from './Timeline.astro';
import Stats from './Stats.astro';
import Gallery from './Gallery.astro';
import Split from './Split.astro';
import Cta from './Cta.astro';
import Steps from './Steps.astro';
import Logos from './Logos.astro';
import Countdown from './Countdown.astro';
import Contact from './Contact.astro';
import Specs from './Specs.astro';
import Listing from './Listing.astro';
import Toc from './Toc.astro';
import '../styles/sections.css';

export const COMPONENTS: Record<BlockType, any> = {
  header: Header,
  footer: Footer,
  hero: Hero,
  killfeed: Killfeed,
  postlog: PostLog,
  inventory: Inventory,
  rules: Rules,
  scoreboard: Scoreboard,
  cover: CoverBlock,
  heading: Heading,
  prose: Prose,
  postlist: PostList,
  embed: Embed,
  search: Search,
  project: Project,
  links: Links,
  roadmap: Roadmap,
  faq: Faq,
  masthead: Masthead,
  features: Features,
  pricing: Pricing,
  testimonials: Testimonials,
  people: People,
  timeline: Timeline,
  stats: Stats,
  gallery: Gallery,
  split: Split,
  cta: Cta,
  steps: Steps,
  logos: Logos,
  countdown: Countdown,
  contact: Contact,
  specs: Specs,
  listing: Listing,
  toc: Toc,
  // Post blocks draw the same way they do inside posts.
  callout: PostBlock,
  aeris: PostBlock,
  pull: PostBlock,
  bignum: PostBlock,
  shout: PostBlock,
  tape: PostBlock,
  notes: PostBlock,
  image: PostBlock,
};

interface Props {
  blocks: BlockData[];
  // Where this list lives, e.g. "home:regions.aside". Each block gets "<path>.<index>".
  path?: Path;
}
const { blocks, path } = Astro.props;
---

{
  blocks.map((block, i) => {
    const Component = COMPONENTS[block.type];
    return <Component block={block} path={path ? `${path}.${i}` : undefined} />;
  })
}
