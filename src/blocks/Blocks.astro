---
// Draws a list of blocks: each block's `type` picks its component.
import type { BlockData, BlockType } from './schema';
import type { Path } from './desk';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Killfeed from './Killfeed.astro';
import PostLog from './PostLog.astro';
import Inventory from './Inventory.astro';
import Rules from './Rules.astro';
import Scoreboard from './Scoreboard.astro';
import CoverBlock from './CoverBlock.astro';
import PostBlock from './PostBlock.astro';
import Heading from './Heading.astro';
import Prose from './Prose.astro';
import PostList from './PostList.astro';
import Embed from './Embed.astro';
import Search from './Search.astro';
import Project from './Project.astro';
import Features from './sections/Features.astro';
import Pricing from './sections/Pricing.astro';
import Faq from './sections/Faq.astro';
import Timeline from './sections/Timeline.astro';
import Roadmap from './sections/Roadmap.astro';
import Stats from './sections/Stats.astro';
import Cta from './sections/Cta.astro';
import Quotes from './sections/Quotes.astro';
import People from './sections/People.astro';
import Links from './sections/Links.astro';
import Gallery from './sections/Gallery.astro';
import Media from './sections/Media.astro';
import Archive from './sections/Archive.astro';
import Table from './sections/Table.astro';
import Status from './sections/Status.astro';
import Countdown from './sections/Countdown.astro';
import Contact from './sections/Contact.astro';
import Downloads from './sections/Downloads.astro';
import Divider from './sections/Divider.astro';

export const COMPONENTS: Record<BlockType, any> = {
  header: Header,
  footer: Footer,
  hero: Hero,
  killfeed: Killfeed,
  postlog: PostLog,
  inventory: Inventory,
  rules: Rules,
  scoreboard: Scoreboard,
  cover: CoverBlock,
  heading: Heading,
  prose: Prose,
  postlist: PostList,
  embed: Embed,
  search: Search,
  project: Project,
  // Section blocks (src/blocks/sections), what page templates are made of.
  features: Features,
  pricing: Pricing,
  faq: Faq,
  timeline: Timeline,
  roadmap: Roadmap,
  stats: Stats,
  cta: Cta,
  quotes: Quotes,
  people: People,
  links: Links,
  gallery: Gallery,
  media: Media,
  archive: Archive,
  table: Table,
  status: Status,
  countdown: Countdown,
  contact: Contact,
  downloads: Downloads,
  divider: Divider,
  // Post blocks draw the same way they do inside posts.
  callout: PostBlock,
  aeris: PostBlock,
  pull: PostBlock,
  bignum: PostBlock,
  shout: PostBlock,
  tape: PostBlock,
  notes: PostBlock,
  image: PostBlock,
};

interface Props {
  blocks: BlockData[];
  // Where this list lives, e.g. "home:regions.aside". Each block gets "<path>.<index>".
  path?: Path;
}
const { blocks, path } = Astro.props;
---

{
  blocks.map((block, i) => {
    const Component = COMPONENTS[block.type];
    return <Component block={block} path={path ? `${path}.${i}` : undefined} />;
  })
}
