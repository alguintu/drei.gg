---
// Counts down to a moment (Manila time) in the browser; without JavaScript it
// shows the date itself.
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';

interface Props { block: BlockData<'countdown'>; path?: Path }
const { block, path } = Astro.props;
const when = new Date(`${block.target}${block.target.length <= 10 ? 'T00:00' : ''}:00+08:00`);
const valid = !Number.isNaN(when.valueOf());
const id = `cd-${Math.random().toString(36).slice(2, 8)}`;
const label = valid ? when.toLocaleString('en-GB', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Manila' }) + ' (Manila)' : block.target;
---

<section class="sec sec-countdown" id={id} {...blockAttrs(path)} data-at={valid ? when.toISOString() : ''} data-done={block.done}>
  <Head label={block.label} heading={block.heading} path={path} />
  <p class="clock" aria-live="polite">
    {['days', 'hours', 'min', 'sec'].map((u) => (
      <span class="unit"><b data-u={u}>--</b><small>{u}</small></span>
    ))}
  </p>
  <p class="when"><time datetime={valid ? when.toISOString() : undefined}>{label}</time></p>
</section>

<script is:inline define:vars={{ id }}>
  (function () {
    var el = document.getElementById(id);
    var at = Date.parse(el.dataset.at);
    if (!at) return;
    var b = {};
    el.querySelectorAll('[data-u]').forEach(function (n) { b[n.dataset.u] = n; });
    function tick() {
      var s = Math.max(0, Math.floor((at - Date.now()) / 1000));
      if (!s && el.dataset.done) { el.querySelector('.clock').textContent = el.dataset.done; return; }
      b.days.textContent = Math.floor(s / 86400);
      b.hours.textContent = String(Math.floor(s / 3600) % 24).padStart(2, '0');
      b.min.textContent = String(Math.floor(s / 60) % 60).padStart(2, '0');
      b.sec.textContent = String(s % 60).padStart(2, '0');
      if (s) setTimeout(tick, 1000);
    }
    tick();
  })();
</script>
