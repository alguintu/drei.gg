---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Text from '../Text.astro';

interface Props { block: BlockData<'media'>; path?: Path }
const { block, path } = Astro.props;
---

<section class={`sec sec-media img-${block.side}`} {...blockAttrs(path)}>
  <div class="copy">
    {block.label && <p class="label" {...slotAttrs(path, 'label')}>{block.label}</p>}
    {block.heading && <h2 {...slotAttrs(path, 'heading')}>{block.heading}</h2>}
    {block.text && <p class="text"><Text path={path} slot="text" text={block.text} rich /></p>}
    {block.button && <p><a class="btn" href={block.href || '#'} {...slotAttrs(path, 'button')}>{block.button}</a></p>}
  </div>
  <figure class="frm frm-offset">
    <span class="frm-in">{block.image ? <img src={block.image} alt={block.alt} loading="lazy" /> : <span class="ph" aria-hidden="true" />}</span>
  </figure>
</section>
