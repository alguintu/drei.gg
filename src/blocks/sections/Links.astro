---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';

interface Props { block: BlockData<'links'>; path?: Path }
const { block, path } = Astro.props;
---

<section class="sec sec-links" {...blockAttrs(path)}>
  <Head label={block.label} heading={block.heading} path={path} />
  <ul>
    {block.items.map((l, i) => (
      <li>
        <a href={l.href || '#'}>
          <b {...slotAttrs(path, `items.${i}.label`)}>{l.label}</b>
          {l.note && <span {...slotAttrs(path, `items.${i}.note`)}>{l.note}</span>}
          <i aria-hidden="true">→</i>
        </a>
      </li>
    ))}
  </ul>
</section>
