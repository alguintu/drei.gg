---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';

interface Props { block: BlockData<'divider'>; path?: Path }
const { block, path } = Astro.props;
---

{
  block.style === 'tape' ? (
    <p class="sec divider d-tape" {...blockAttrs(path)}><span {...slotAttrs(path, 'text')}>{block.text || 'gg'}</span></p>
  ) : (
    <hr class={`sec divider d-${block.style}`} {...blockAttrs(path)} />
  )
}
