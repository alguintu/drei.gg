---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';

interface Props { block: BlockData<'downloads'>; path?: Path }
const { block, path } = Astro.props;
---

<section class="sec sec-downloads" {...blockAttrs(path)}>
  <Head label={block.label} heading={block.heading} path={path} />
  <ul>
    {block.items.map((f, i) => (
      <li>
        <a href={f.href || '#'} download>
          <span class="ext" aria-hidden="true">{(f.href.split('.').pop() || 'file').slice(0, 4)}</span>
          <b {...slotAttrs(path, `items.${i}.name`)}>{f.name}</b>
          {f.note && <span class="note" {...slotAttrs(path, `items.${i}.note`)}>{f.note}</span>}
          {f.size && <span class="size" {...slotAttrs(path, `items.${i}.size`)}>{f.size}</span>}
          <i aria-hidden="true">↓</i>
        </a>
      </li>
    ))}
  </ul>
</section>
