---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';

interface Props { block: BlockData<'table'>; path?: Path }
const { block, path } = Astro.props;
const cells = (row: string) => row.split('|').map((c) => c.trim());
const cols = cells(block.columns);
---

<section class="sec sec-table" {...blockAttrs(path)}>
  <Head label={block.label} heading={block.heading} path={path} />
  <div class="scroll" tabindex="0" role="region" aria-label={block.heading || block.label || 'Table'}>
    <table>
      <thead>
        <tr {...slotAttrs(path, 'columns')}>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {block.rows.map((r, i) => (
          <tr {...slotAttrs(path, `rows.${i}`)}>
            {cells(r).map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
