---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';
import Text from '../Text.astro';

interface Props { block: BlockData<'features'>; path?: Path }
const { block, path } = Astro.props;
// Item titles sit under the section's heading, or stand in for it when there's none.
const H = block.heading ? 'h3' : 'h2';
---

<section class={`sec sec-features cols-${block.columns}`} {...blockAttrs(path)}>
  <Head label={block.label} heading={block.heading} path={path} />
  <div class="grid">
    {block.items.map((f, i) => (
      <div class="feature">
        {f.glyph && <span class="glyph" aria-hidden="true">{f.glyph}</span>}
        <H class="t" {...slotAttrs(path, `items.${i}.title`)}>{f.title}</H>
        <p><Text path={path} slot={`items.${i}.text`} text={f.text} rich /></p>
      </div>
    ))}
  </div>
</section>
