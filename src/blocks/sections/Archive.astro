---
// Every post, grouped by year, like /log/: for pages that want the whole log.
import PostRows from '../../components/PostRows.astro';
import TagNav from '../../components/TagNav.astro';
import { getPosts } from '../../lib/posts';
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import '../../styles/extras.css';

interface Props { block: BlockData<'archive'>; path?: Path }
const { block, path } = Astro.props;
const posts = await getPosts();
---

<section class="sec sec-archive archive" {...blockAttrs(path)}>
  {block.label && <p class="label" {...slotAttrs(path, 'label')}>{block.label}</p>}
  {block.tags && <TagNav posts={posts} />}
  {posts.length ? <PostRows posts={posts} /> : <p class="empty-log">Nothing posted yet.</p>}
</section>
