---
import type { BlockData } from '../schema';
import { blockAttrs, slotAttrs, type Path } from '../desk';
import Head from './Head.astro';

interface Props { block: BlockData<'quotes'>; path?: Path }
const { block, path } = Astro.props;
---

<section class="sec sec-quotes" {...blockAttrs(path)}>
  <Head label={block.label} heading={block.heading} path={path} />
  <div class="grid">
    {block.items.map((q, i) => (
      <figure>
        <span class="qm" aria-hidden="true">“</span>
        <blockquote {...slotAttrs(path, `items.${i}.quote`)}>{q.quote}</blockquote>
        <figcaption>
          <b {...slotAttrs(path, `items.${i}.who`)}>{q.who}</b>
          {q.role && <span {...slotAttrs(path, `items.${i}.role`)}>{q.role}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
