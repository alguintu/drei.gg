---
// An image beside a block of text, either side. No image: a hatched panel.
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { markdown } from '../lib/markdown.mjs';
import type { BlockData } from './schema';
import { blockAttrs, slotAttrs, type Path } from './desk';
import Text from './Text.astro';

interface Props {
  block: BlockData<'split'>;
  path?: Path;
}
const { block, path } = Astro.props;
const md = await createMarkdownProcessor(markdown as any);
const { code } = await md.render(block.body ?? '');
---

<section class={`split img-${block.side}`} {...blockAttrs(path)}>
  <figure class={`split-img frame${block.image ? '' : ' ph'}`}>
    {block.image && <img src={block.image} alt={block.image_alt ?? ''} loading="lazy" />}
  </figure>
  <div class="split-copy">
    {block.kicker && <p class="label kicker" {...slotAttrs(path, 'kicker')}>{block.kicker}</p>}
    <h2 class="split-title"><Text path={path} slot="title" text={block.title} rich /></h2>
    <div class="prose" {...slotAttrs(path, 'body')} set:html={code} />
    {
      block.cta_label && block.cta_href && (
        <p class="btns">
          <a class="btn" href={block.cta_href} {...slotAttrs(path, 'cta_label')}>
            {block.cta_label}
          </a>
        </p>
      )
    }
  </div>
</section>
