---
import type { BlockData } from './schema';
import { blockAttrs, slotAttrs, type Path } from './desk';
import Text from './Text.astro';

interface Props {
  block: BlockData<'killfeed'>;
  path?: Path;
}
const { block, path } = Astro.props;
// Scrolling runs two copies of the feed side by side and slides by one copy, so
// the loop has no seam. The copy is hidden from screen readers and from the desk.
const scroll = block.motion === 'scroll';
const time = `--feed-time: ${Math.max(20, block.items.length * 7)}s`;
---

<div class:list={['feed', { scroll }]} role="region" aria-label="Recent activity" {...blockAttrs(path)} style={scroll ? time : undefined}>
  <div class="wrap">
    {
      scroll ? (
        <div class="track">
          {[path, undefined].map((p, copy) => (
            <div class="set" aria-hidden={copy ? 'true' : undefined}>
              {block.items.map((k, i) => (
                <span class="kill">
                  <b {...slotAttrs(p, `items.${i}.who`)}>{k.who}</b> <span class={k.style === 'bad' ? 'x' : 'v'}>[<Text path={p} slot={`items.${i}.verb`} text={k.verb} />]</span> <Text path={p} slot={`items.${i}.what`} text={k.what} />
                </span>
              ))}
            </div>
          ))}
        </div>
      ) : (
        block.items.map((k, i) => (
          <span class="kill">
            <b {...slotAttrs(path, `items.${i}.who`)}>{k.who}</b> <span class={k.style === 'bad' ? 'x' : 'v'}>[<Text path={path} slot={`items.${i}.verb`} text={k.verb} />]</span> <Text path={path} slot={`items.${i}.what`} text={k.what} />
          </span>
        ))
      )
    }
  </div>
</div>
