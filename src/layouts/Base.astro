---
import '../styles/global.css';
import '../styles/cover.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry } from 'astro:content';
import Region from '../blocks/Region.astro';
import { themeCss } from '../lib/theme';
import theme from '../data/theme.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // A social card under public/, e.g. /og/my-post.jpg. Defaults to the site's card.
  image?: string;
}

const {
  title,
  description = 'A devlog. We build things and post about them. No funnel, no launch week.',
  noindex = false,
} = Astro.props;
// Social cards are made by the desk (public/og); use one only if it's there.
const card = [Astro.props.image, '/og/site.jpg'].find((p) => p && existsSync(join(process.cwd(), 'public', p)));
const cardUrl = card && new URL(card, Astro.site);
const pageTitle = title ? `${title} · drei.gg` : 'drei.gg';
const canonical = new URL(Astro.url.pathname, Astro.site);
// The header and footer every page shares: the `frame` page (src/content/pages/frame.json).
const frame = (await getEntry('pages', 'frame'))!;
// Colors changed in the desk's Theme (src/data/theme.json); empty when none are.
const themed = themeCss(theme);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="drei.gg" href="/feed.xml" />
    {themed && <style is:inline set:html={themed} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {cardUrl && <meta property="og:image" content={cardUrl} />}
    {cardUrl && <meta property="og:image:width" content="1200" />}
    {cardUrl && <meta property="og:image:height" content="675" />}
    {cardUrl && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#15171d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,400..900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;600&family=Nothing+You+Could+Do&display=swap"
    />
    <script is:inline>
      // Apply a saved theme before first paint so there's no flash.
      try {
        var saved = localStorage.getItem('drei-theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <Region page={frame} name="header" />

    <slot />

    <Region page={frame} name="footer" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var label = document.getElementById('theme-label');
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function current() { return root.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function paint() { label.textContent = current() === 'dark' ? 'light mode' : 'dark mode'; }
        paint();
        if (mq.addEventListener) mq.addEventListener('change', paint);
        document.getElementById('theme-toggle').addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('drei-theme', next); } catch (e) {}
          paint();
        });
      })();
    </script>
  </body>
</html>
