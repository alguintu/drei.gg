---
// The desk's template gallery: every page template drawn live, at a small scale,
// grouped. "Use this" asks the desk to start a new page from it; "open" shows it
// full size. Dev only: it never ships.
import Base from '../../../layouts/Base.astro';
import { GROUPS, TEMPLATE_LIST } from '../../../lib/templates';

// A rest route only so it can be left out of builds: /desk/templates/ in dev, nothing in production.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { index: undefined } }] : [];
}
---

<Base title="Templates" noindex>
  <main class="single templates">
    <div class="wrap">
      <header class="page-head">
        <p class="label">{TEMPLATE_LIST.length} page templates</p>
        <h1>Start from something</h1>
      </header>
      {
        GROUPS.map((g) => (
          <section>
            <h2>{g}</h2>
            <div class="grid">
              {TEMPLATE_LIST.filter((t) => t.group === g).map((t) => (
                <article class="tpl">
                  <a class="shot" href={`/desk/template/${t.id}/`} aria-label={`Open the ${t.name} template`}>
                    <iframe src={`/desk/template/${t.id}/`} title={t.name} loading="lazy" tabindex="-1" aria-hidden="true" />
                  </a>
                  <div class="meta">
                    <h3>{t.name}</h3>
                    <p>{t.description}</p>
                    <p class="act">
                      <button type="button" class="use" data-id={t.id}>use this</button>
                      <a href={`/desk/template/${t.id}/`}>open</a>
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Base>

<script>
  // In the desk's preview, "use this" hands the template to the editor.
  document.querySelectorAll<HTMLButtonElement>('.use').forEach((b) =>
    b.addEventListener('click', () => {
      if (parent !== window) parent.postMessage({ desk: 'catalog', template: b.dataset.id }, location.origin);
      else alert('Open the gallery from the desk to start a page from it.');
    }),
  );
</script>

<style>
  .templates h2 { font: 800 24px/1 var(--display); font-stretch: 80%; margin: 40px 0 14px; }
  .grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .tpl { border: 1px solid var(--line); background: var(--panel); display: grid; }
  .shot { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper); border-bottom: 1px solid var(--line); }
  /* A 1280px-wide page, scaled to the card. */
  .shot iframe { position: absolute; left: 0; top: 0; width: 1280px; height: 960px; border: 0; transform: scale(var(--s, .25)); transform-origin: 0 0; pointer-events: none; }
  .shot:hover { outline: 3px solid var(--marker); outline-offset: -3px; }
  .meta { padding: 14px 16px; display: grid; gap: 6px; }
  .meta h3 { font: 800 18px/1.1 var(--display); font-stretch: 85%; margin: 0; }
  .meta p { margin: 0; font-size: 14px; color: var(--mute); }
  .act { display: flex; gap: 14px; align-items: center; margin-top: 6px !important; }
  .use { font: 700 12px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em; padding: 9px 12px; background: var(--marker); color: #15171d; border: 0; box-shadow: 3px 3px 0 var(--ink); cursor: pointer; }
  .act a { font: 600 12px/1 var(--mono); }
</style>

<script>
  // Fit each 1280px page to its card's width.
  const ro = new ResizeObserver((entries) => entries.forEach((e) => (e.target as HTMLElement).style.setProperty('--s', String(e.contentRect.width / 1280))));
  document.querySelectorAll('.shot').forEach((s) => ro.observe(s));
</script>
