---
// A post's cover alone at 1200×675, for the desk to screenshot into the post's
// social card (public/og/<id>.jpg). Dev only: nothing here is built for the site.
import { getCollection } from 'astro:content';
import PostCover from '../../../components/PostCover.astro';
import type { Post } from '../../../lib/posts';
import '../../../styles/global.css';
import '../../../styles/cover.css';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return (await getCollection('posts')).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,400..900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;600&family=Nothing+You+Could+Do&display=swap"
    />
    <style is:global>
      html, body { margin: 0; width: 1200px; height: 675px; overflow: hidden; background: #15171d; }
      .og .cv { width: 1200px; border: 0; }
    </style>
  </head>
  <body>
    <div class="og"><PostCover post={post} /></div>
  </body>
</html>
