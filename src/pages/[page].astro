---
// Pages made in the desk: every page in src/content/pages with a page template
// (basic, wide, sidebar, docs), at /<id>/.
import { getCollection, type CollectionEntry } from 'astro:content';
import CodeCopy from '../components/CodeCopy.astro';
import PageBody from '../components/PageBody.astro';
import Base from '../layouts/Base.astro';
import { PAGE_TEMPLATES } from '../blocks/schema';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => (PAGE_TEMPLATES as readonly string[]).includes(data.template) && (import.meta.env.DEV || !data.draft));
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
---

<Base title={page.data.title}>
  <PageBody page={page} />
  <CodeCopy />
</Base>
