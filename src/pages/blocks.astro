---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { LAYOUTS, TYPE_LAYOUTS, PALETTES } from '../lib/cover';
import { Content as Blocks } from '../demo/blocks.md';
import hero from '../demo/sample-hero.jpg';
import log from '../demo/sample-log.jpg';
import phone from '../demo/sample-phone.jpg';
import dark from '../demo/sample-dark.jpg';

// Every cover layout in every palette, plus the in-post blocks.
// Not linked from the site; it's a picker for writing posts.
const images = [hero, log, dark, phone];
const sample = {
  title: 'We bought drei.gg. That’s the whole update.',
  summary: 'The domain kept calling. Here’s why it does three jobs.',
  date: new Date('2026-10-16'),
  label: 'v0.0.1',
};
const kickers: Record<string, string> = {
  giveaway: 'SHIPPED', streetwear: 'SHIPPED', everyday: 'BUILD', offset: 'BUILD', overlay: 'RANT', bracket: 'RANT',
  tiles: 'NEW', caption: 'NEW LOOK', quarter: 'DEAD', spread: 'SHIP', lshape: 'BUILD', mono: 'NEW',
  split: 'NEW', circle: 'BUILD', twin: 'LOG', ushape: 'SHIPPED', bleed: 'RANT', arch: 'BUILD', polaroid: 'AERIS',
  filmstrip: 'BUILD', browser: 'SHIPPED',
  repeat: 'SHIPPED', arc: 'SHIPPED', stripes: 'GG', bignum: '80%', collection: 'BUILD', clearance: 'SHIPPED',
  wild: 'buildanyway', promo: 'V0.1', quote: 'RANT', term: 'BUILD',
};
---

<Base title="Blocks" noindex>
  <main class="single blocks-page">
    <div class="wrap">
      <a class="back" href="/">← home</a>
      <h1>Post blocks</h1>
      <p class="intro">
        Every post gets a cover. Set <code>image</code>, <code>layout</code>, <code>palette</code> and
        <code>kicker</code> in a post's front matter; leave layout and palette out and the post's filename picks them, from
        the image layouts when the post has an image and the type layouts when it doesn't.
        {LAYOUTS.length + TYPE_LAYOUTS.length} layouts × {PALETTES.length} palettes. Grey boxes stand in for the post image.
      </p>

      <h2 class="group">Image layouts <span>{LAYOUTS.length}</span></h2>
      {
        LAYOUTS.map((layout) => (
          <section class="layout-row">
            <h2>
              <code>layout: {layout}</code>
            </h2>
            <div class="swatches">
              {PALETTES.map((palette, j) => (
                <div>
                  <Cover layout={layout} palette={palette} kicker={kickers[layout]} {...sample} image={images[j % images.length]} imageAlt="" size="card" />
                  <p class="cap">
                    <code>palette: {palette}</code>
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <h2 class="group">Type layouts <span>{TYPE_LAYOUTS.length}</span></h2>
      {
        TYPE_LAYOUTS.map((layout) => (
          <section class="layout-row">
            <h2>
              <code>layout: {layout}</code>
            </h2>
            <div class="swatches">
              {PALETTES.map((palette) => (
                <div>
                  <Cover layout={layout} palette={palette} kicker={kickers[layout]} {...sample} size="card" />
                  <p class="cap">
                    <code>palette: {palette}</code>
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <section class="layout-row">
        <h2>No image</h2>
        <p class="intro">A post without an image gets a type layout. If you pick an image layout anyway, the image slot becomes a hatched panel with the kicker.</p>
        <div class="swatches">
          {
            ['giveaway', 'caption', 'mono'].map((layout) => (
              <Cover layout={layout as any} palette="marker" kicker={kickers[layout]} {...sample} size="card" />
            ))
          }
        </div>
      </section>

      <section class="layout-row">
        <h2>In-post blocks</h2>
        <p class="intro">
          Fenced blocks in a post's Markdown; the fence name picks the block, e.g. <code>```callout</code>. Images get a frame
          from their title: <code>![alt](./shot.png "offset | caption")</code>.
        </p>
        <div class="prose"><Blocks /></div>
      </section>
    </div>
  </main>
</Base>

<style>
  .blocks-page h1 { margin-bottom: 8px; }
  .intro { color: var(--mute); max-width: 70ch; margin: 0 0 24px; }
  .layout-row { border-top: 1px solid var(--line); padding-block: 24px; }
  .layout-row h2 { font: 600 14px/1 var(--mono); margin: 0 0 16px; }
  h2.group { font: 800 28px/1 var(--display); margin: 56px 0 8px; }
  h2.group span { font: 600 14px/1 var(--mono); color: var(--team); vertical-align: middle; }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 18px; }
  .cap { margin: 6px 0 0; font: 12px/1 var(--mono); color: var(--mute); }
</style>
