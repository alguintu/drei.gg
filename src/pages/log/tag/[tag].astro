---
// One page per tag: /log/tag/ship/, /log/tag/rant/ ...
import Base from '../../../layouts/Base.astro';
import PostRows from '../../../components/PostRows.astro';
import TagNav from '../../../components/TagNav.astro';
import { getPosts, LABELS, type Post } from '../../../lib/posts';
import '../../../styles/extras.css';

export function getStaticPaths() {
  return Object.keys(LABELS).map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag as Post['data']['tag'];
const all = await getPosts();
const posts = all.filter((p) => p.data.tag === tag);
---

<Base title={`#${LABELS[tag]}`} description={`Posts tagged ${LABELS[tag]} on drei.gg.`}>
  <main class="single archive">
    <div class="wrap">
      <a class="back" href="/log/">← the whole log</a>
      <h1>#{LABELS[tag]}</h1>
      <TagNav posts={all} current={tag} />
      {posts.length ? <PostRows posts={posts} /> : <p class="empty">Nothing here yet. Give it time.</p>}
    </div>
  </main>
</Base>
