---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostCover from '../../components/PostCover.astro';
import { getPosts, postUrl, type Post } from '../../lib/posts';
import Region from '../../blocks/Region.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
// Blocks above and below every post's article: src/content/pages/post.json.
const template = (await getEntry('pages', 'post'))!;
---

<Base title={post.data.title} description={post.data.summary} image={`/og/${post.id}.jpg`}>
  <main class="single">
    <div class="wrap">
      <a class="back" href="/#log">← back to the log</a>
      <Region page={template} name="top" />
      <article>
        <PostMeta post={post} />
        <h1>{post.data.title}</h1>
        <div class="cover-full"><PostCover post={post} /></div>
        <div class="prose"><Content /></div>
        <nav class="pager" aria-label="More posts">
          {older ? <a href={postUrl(older)}>← {older.data.title}</a> : <span />}
          {newer ? <a href={postUrl(newer)}>{newer.data.title} →</a> : <span />}
        </nav>
      </article>
      <Region page={template} name="bottom" />
    </div>
  </main>
</Base>
