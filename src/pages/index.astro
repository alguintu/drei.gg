---
// The home page: src/content/pages/home.json, a page made of blocks.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Region from '../blocks/Region.astro';

const page = (await getEntry('pages', 'home'))!;
---

<Base>
  <Region page={page} name="top" />

  <main>
    <div class="wrap">
      <Region page={page} name="main" />

      <aside>
        <Region page={page} name="aside" />
      </aside>
    </div>
  </main>
</Base>
